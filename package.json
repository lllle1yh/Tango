{
  "name": "tango",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first workspace for existing AI agents",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --config ui/vite.config.mts\" \"tsc -p tsconfig.node.json --watch\" \"wait-on tcp:5173 dist-electron/electron/main.js && electron .\"",
    "build": "tsc -b && vite build --config ui/vite.config.mts",
    "typecheck": "tsc -b --pretty",
    "terminal:smoke": "npm run build && electron . --pty-smoke"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
