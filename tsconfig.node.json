{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": false,
    "outDir": "dist-electron",
    "rootDir": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["electron", "ui/vite.config.mts"]
}
